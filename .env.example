# === Telegram ===
# Токен бота от @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# ID группы участников. Можно оставить пустым: бот подскажет командой /chatid
TELEGRAM_CHAT_ID=

# === Claude (Anthropic) ===
# console.anthropic.com -> API Keys -> Create Key
ANTHROPIC_API_KEY=
# Модели можно менять при желании
MODEL_MAIN=claude-sonnet-4-6
MODEL_FAST=claude-haiku-4-5-20251001

# === Турнир ===
# ID Google-таблицы (уже подставлен)
SHEET_ID=1QCXWhUI5JAIG2otuMykCKcAFllWWk-voEAMM47RZf1I
# gid вкладок
GID_STANDINGS=1174225275
GID_MATCHES=61546759
# вкладка с матрицей потенциала «у кого что на кону» (пришлёшь gid)
GID_POTENTIAL=

# === Расписание матчей (football-data.org) ===
# Бесплатный ключ: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# === Котировки букмекеров (the-odds-api.com) ===
# Бесплатный ключ: https://the-odds-api.com/  (регистрация -> API key)
ODDS_API_KEY=

# === Поведение ===
# Часовой пояс для расписания/анонсов
TIMEZONE=Europe/Moscow
# За сколько часов до матча кидать анонс
ANNOUNCE_HOURS_BEFORE=3
# Вероятность (0..1), что бот сам влезет с подколом в обычное сообщение
REPLY_PROBABILITY=0.05
